# 服务公网地址（用于生成小程序时自动填充登录接口）
SERVER_PUBLIC_URL=https://你的域名.com

# wxApp 登录服务地址（merchantDashboard 转发 /api/core/ 时使用，默认 127.0.0.1:3000）
# WXAPP_SERVICE_URL=http://127.0.0.1:3000

# 明道云 API（用于从明道云读取商家小程序配置）
MINGDAO_APP_KEY=你的明道云appKey
MINGDAO_SIGN=你的明道云sign

# 可选：商家配置所在工作表，默认 shangjia
# MINGDAO_MERCHANT_WORKSHEET_ID=shangjia

# 可选：字段名（明道云列 controlId），默认如下
# MINGDAO_MERCHANT_ID_FIELD=mRowid
# MINGDAO_APPID_FIELD=appId
# MINGDAO_APPSECRET_FIELD=appSecret
