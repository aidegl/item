{
  "globalVariables": {
    "description": "全局变量，所有页面共享",
    "variables": [
      {
        "name": "merchantId",
        "type": "string",
        "description": "商家ID，从URL参数mRowid获取",
        "source": "URL参数",
        "example": "6987e4a94a70f651557bceea",
        "usage": "用于查询商家数据、权限验证"
      },
      {
        "name": "userId",
        "type": "string",
        "description": "用户ID，从URL参数userId获取",
        "source": "URL参数",
        "example": "user123",
        "usage": "用户身份识别、操作日志"
      },
      {
        "name": "merchantData",
        "type": "object",
        "description": "商家完整数据，从明道云获取",
        "source": "明道云API",
        "storage": "localStorage",
        "usage": "存储商家基本信息、配置等"
      },
      {
        "name": "apiBaseUrl",
        "type": "string",
        "description": "API基础URL",
        "source": "配置",
        "example": "https://api.mingdao.com",
        "usage": "所有API请求的基础地址"
      },
      {
        "name": "version",
        "type": "string",
        "description": "版本号，用于强制刷新资源",
        "source": "URL参数或时间戳",
        "example": "1234567890",
        "usage": "资源版本控制"
      }
    ]
  },
  "pageVariables": {
    "description": "页面变量，各页面独立",
    "pages": [
      {
        "pageName": "shouye",
        "pageId": "shouye.html",
        "description": "首页",
        "variables": [
          {
            "name": "shopName",
            "type": "string",
            "description": "店铺名称",
            "elementId": "shopName",
            "source": "merchantData.mingcheng",
            "defaultValue": "加载中..."
          },
          {
            "name": "shopId",
            "type": "string",
            "description": "店铺ID",
            "elementId": "shopId",
            "source": "merchantData.rowid",
            "defaultValue": "店铺ID: --"
          },
          {
            "name": "shopType",
            "type": "string",
            "description": "店铺类型",
            "elementId": "shopType",
            "source": "merchantData.leixing",
            "defaultValue": "店铺类型: --"
          },
          {
            "name": "shopStatus",
            "type": "number",
            "description": "店铺状态（1营业中，0已打烊）",
            "elementId": "shopStatus",
            "source": "merchantData.zhuangtai",
            "defaultValue": 1
          },
          {
            "name": "userCount",
            "type": "number",
            "description": "用户数量",
            "elementId": "userCount",
            "source": "运营数据API",
            "defaultValue": "--"
          },
          {
            "name": "orderCount",
            "type": "number",
            "description": "订单数量",
            "elementId": "orderCount",
            "source": "运营数据API",
            "defaultValue": "--"
          },
          {
            "name": "deliveryCount",
            "type": "number",
            "description": "配送数量",
            "elementId": "deliveryCount",
            "source": "运营数据API",
            "defaultValue": "--"
          },
          {
            "name": "memberCount",
            "type": "number",
            "description": "会员数量",
            "elementId": "memberCount",
            "source": "运营数据API",
            "defaultValue": "--"
          },
          {
            "name": "codeVersion",
            "type": "string",
            "description": "代码版本",
            "elementId": "codeVersion",
            "source": "配置",
            "defaultValue": "版本: v1.0.0"
          },
          {
            "name": "codeStatus",
            "type": "string",
            "description": "代码状态",
            "elementId": "codeStatus",
            "source": "配置",
            "defaultValue": "当前版本运行正常"
          }
        ]
      },
      {
        "pageName": "shopManage",
        "pageId": "shopManage.html",
        "description": "店铺管理",
        "subMenus": [
          "店铺资料",
          "门店管理",
          "下单设置",
          "更多设置",
          "图片空间"
        ],
        "variables": [
          {
            "name": "shopInfo",
            "type": "object",
            "description": "店铺基本信息",
            "source": "merchantData"
          },
          {
            "name": "shopLogo",
            "type": "string",
            "description": "店铺Logo",
            "source": "merchantData.logo[0].large_thumbnail_full_path"
          },
          {
            "name": "shopAddress",
            "type": "string",
            "description": "店铺地址",
            "source": "merchantData.dizhi"
          },
          {
            "name": "shopPhone",
            "type": "string",
            "description": "店铺电话",
            "source": "merchantData.dianhua"
          }
        ]
      },
      {
        "pageName": "productManage",
        "pageId": "productManage.html",
        "description": "商品管理",
        "variables": [
          {
            "name": "productList",
            "type": "array",
            "description": "商品列表",
            "source": "明道云API"
          },
          {
            "name": "productCategory",
            "type": "array",
            "description": "商品分类",
            "source": "明道云API"
          },
          {
            "name": "selectedProduct",
            "type": "object",
            "description": "当前选中的商品",
            "source": "用户操作"
          }
        ]
      },
      {
        "pageName": "orderManage",
        "pageId": "orderManage.html",
        "description": "订单管理",
        "variables": [
          {
            "name": "orderList",
            "type": "array",
            "description": "订单列表",
            "source": "明道云API"
          },
          {
            "name": "orderStatus",
            "type": "string",
            "description": "订单状态筛选",
            "source": "用户操作",
            "options": [
              "全部",
              "待支付",
              "待发货",
              "已发货",
              "已完成",
              "已取消"
            ]
          },
          {
            "name": "selectedOrder",
            "type": "object",
            "description": "当前选中的订单",
            "source": "用户操作"
          }
        ]
      },
      {
        "pageName": "deliveryManage",
        "pageId": "deliveryManage.html",
        "description": "配送管理",
        "variables": [
          {
            "name": "deliveryList",
            "type": "array",
            "description": "配送列表",
            "source": "明道云API"
          },
          {
            "name": "deliveryStatus",
            "type": "string",
            "description": "配送状态筛选",
            "source": "用户操作",
            "options": [
              "全部",
              "待接单",
              "配送中",
              "已完成",
              "已取消"
            ]
          }
        ]
      },
      {
        "pageName": "memberManage",
        "pageId": "memberManage.html",
        "description": "会员管理",
        "variables": [
          {
            "name": "memberList",
            "type": "array",
            "description": "会员列表",
            "source": "明道云API"
          },
          {
            "name": "memberLevel",
            "type": "array",
            "description": "会员等级",
            "source": "明道云API"
          },
          {
            "name": "memberPoints",
            "type": "number",
            "description": "会员积分规则",
            "source": "merchantData.jifen"
          }
        ]
      },
      {
        "pageName": "marketing",
        "pageId": "marketing.html",
        "description": "智慧营销",
        "variables": [
          {
            "name": "couponList",
            "type": "array",
            "description": "优惠券列表",
            "source": "明道云API"
          },
          {
            "name": "activityList",
            "type": "array",
            "description": "活动列表",
            "source": "明道云API"
          },
          {
            "name": "seckillList",
            "type": "array",
            "description": "秒杀活动列表",
            "source": "明道云API"
          }
        ]
      },
      {
        "pageName": "circleManage",
        "pageId": "circleManage.html",
        "description": "圈子管理",
        "variables": [
          {
            "name": "circleList",
            "type": "array",
            "description": "圈子列表",
            "source": "明道云API"
          },
          {
            "name": "postList",
            "type": "array",
            "description": "帖子列表",
            "source": "明道云API"
          }
        ]
      },
      {
        "pageName": "contentManage",
        "pageId": "contentManage.html",
        "description": "内容管理",
        "variables": [
          {
            "name": "articleList",
            "type": "array",
            "description": "文章列表",
            "source": "明道云API"
          },
          {
            "name": "bannerList",
            "type": "array",
            "description": "轮播图列表",
            "source": "明道云API"
          }
        ]
      },
      {
        "pageName": "systemSettings",
        "pageId": "systemSettings.html",
        "description": "系统设置",
        "variables": [
          {
            "name": "systemConfig",
            "type": "object",
            "description": "系统配置",
            "source": "merchantData.peizhi"
          },
          {
            "name": "notificationSettings",
            "type": "object",
            "description": "通知设置",
            "source": "merchantData.tongzhi"
          },
          {
            "name": "paymentSettings",
            "type": "object",
            "description": "支付设置",
            "source": "merchantData.zhifu"
          }
        ]
      }
    ]
  }
}