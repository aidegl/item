    // 加载商家数据
    this.loadMerchantData(merchantId);
  },

  loadMerchantData(merchantId) {
    wx.request({
      url: 'https://api.example.com/merchant/data',
      data: {
        merchantId: merchantId
      },
      success: (res) => {
        this.setData({
          merchantData: res.data
        });
      }
    });
  }
});`;
}
