function generatePageJS(page, merchantId) {
    const components = page.components || [];
    const data = components.map(comp => {
        const items = comp.componentItems || [];
        const props = comp.properties || {};
        return `    ${comp.componentName}: ${JSON.stringify({ items, ...props })}`;
    }).join(',\n');

    return `Page({
  data: {
${data}
  },

  onLoad(options) {
    console.log('页面加载:', options);
    // 获取商家ID
    const app = getApp();
    const merchantId = app.globalData.merchantId || '${merchantId}';
