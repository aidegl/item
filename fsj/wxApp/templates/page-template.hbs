Page({
  data: {
    {{#each components}}
    {{componentName}}: {{{json componentItems}}},
    {{/each}}
  },

  onLoad(options) {
    console.log('页面加载');
  },

  onReady() {
    console.log('页面渲染完成');
  },

  onShow() {
    console.log('页面显示');
  },

  onHide() {
    console.log('页面隐藏');
  },

  onUnload() {
    console.log('页面卸载');
  },

  onPullDownRefresh() {
    console.log('下拉刷新');
  },

  onReachBottom() {
    console.log('触底加载');
  }
});
