[Unit]
Description=OpenClaw Auto-Chat Daemon (小粽 ↔ 风 自动通信)
After=network.target openclaw-gateway.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/openclaw/workspace/KnowledgeBase
ExecStart=/usr/bin/node /home/admin/openclaw/workspace/KnowledgeBase/auto-chat.js daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/openclaw-auto-chat.log
StandardError=append:/var/log/openclaw-auto-chat.log
Environment=NODE_ENV=production

# 资源限制
LimitNOFILE=65536
Nice=10

[Install]
WantedBy=multi-user.target
