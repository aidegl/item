epth correctly set. The target object needs to be specified."},order:4505,groupName:"default",params:[{name:"target",locale:{en:"overlapTarget",zh:"重叠对象"}}],linkZH:"",linkEN:""}],locale:{zh:"canvas-overlap",en:"canvas-overlap"},order:0},{name:"canvas-page",locale:{en:"Page",zh:"页面"},props:[{name:"backgroundColor",locale:{zh:"背景颜色",en:"backgroundColor"},type:"Color",desc:{zh:"当前组件的背景颜色。\n",en:"Sets the background color of the component.\nAlpha is the opacity of color.\nColor Names are supported by all browsers in HTML5.\nExample:\n#FF0000\nrgba(255,0,0,0.82)\nblack"},order:4506,groupName:"color",linkZH:"",linkEN:""},{name:"preload",type:"Boolean",locale:{zh:"资源预加载",en:"preload"},desc:{zh:"在案例打开加载阶段，预加载此页面中的图片资源，以及打开了预加载选项的音频资源。（注意，视频资源不支持预加载，都是实时流解析，而非静态资源）。打开资源预加载之后，该页面中的图片素材的显示会更加实时，而不会出现页面显示时，图片资源一个一个的加载出来。但预加载会延长案例加载等待的时间，且会增加案例运行时对设备内存的占用，所以请根据实际需求来选择是否预加载。同时，iVX的cdn资源收费，是按实际使用情况来计算的，比如，一个应用有10个页面，但一个用户只看了第一个，那2-9个页面的素材资源，是不会计算扣费的，但是，如果你将2-9个页面的素材资源打开了预加载，那即使用户没有使用到2-9页面，这些预加载的素材由于也是从cdn下载回用户的手机，因此也会产生费用了。",en:"preload"},order:11020,groupName:"behavior",linkZH:"",linkEN:""}],events:[{name:"show",locale:{en:"display",zh:"显示"},desc:{zh:"页面加载完并显示时触发。",en:"Occurs when the Page is displayed."},order:4507,groupName:"default",linkZH:"",linkEN:""},{name:"hide",locale:{en:"leave",zh:"隐藏"},desc:{zh:"当前页面跳转至其它页面时触发。",en:"Occurs when the program leaves current Page and goes to another Page."},order:4508,groupName:"default",linkZH:"",linkEN:""},{name:"click",locale:{en:"click",zh:"点击"},params:[{name:"globalX",locale:{en:"canvasX",zh:"X坐标"},type:"Number",desc:{zh:"当前点相对于整个页面的X坐标。",en:""}},{name:"globalY",locale:{en:"canvasY",zh:"Y坐标"},type:"Number",desc:{zh:"当前点相对于整个页面的Y坐标。",en:""}}],desc:{zh:"鼠标单击或手指点击组件或其子元素时触发。",en:"Occurs when the user clicks the component."},order:4509,groupName:"default",linkZH:"",linkEN:""},{name:"pointerdown",locale:{en:"touchStart",zh:"手指按下"},params:[{name:"globalX",locale:{en:"canvasX",zh:"X坐标"},type:"Number",desc:{zh:"当前点相对于整个页面的X坐标。",en:""}},{name