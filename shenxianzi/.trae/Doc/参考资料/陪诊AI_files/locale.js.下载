-SW11",linkEN:""},{name:"autoPlay",locale:{en:"autoPlay",zh:"自动播放"},type:"Boolean",desc:{zh:"音频是否自动播放。目前大部分浏览器，禁止音视频在无用户交互时自动播放，因此这个属性的适配性很低，建议通过用户交互事件，比如点击，手指按下，触发音频播放。",en:"Defines whether to play the audio automatically after initialization."},order:5361,groupName:"default",showDes:1,linkZH:"",linkEN:""},{name:"loop",locale:{en:"loop",zh:"循环播放"},type:"Boolean",desc:{zh:"音频播放结束是否重新播放。通过开关控制。默认为不循环播放，即播放一遍即自动停止。",en:"Defines whether to play the audio in loop."},order:5358,groupName:"default",linkZH:"",linkEN:""},{name:"audioContextMode",type:"Boolean",locale:{zh:"预缓存",en:"cache"},desc:{zh:"在音频开始播放前预加载音频资源，并使用audio context的方法来将音频缓存至浏览器内存，然后播放，这个方法，可以让音频对播放事件有更好的响应，比如，制作游戏音效等，建议开启缓存模式。同时，缓存模式的音频，可以和视频一起播放，而不会当视频播放的时候被强制暂停。但开启缓存模式，自然会增加浏览器内存消耗，建议仅针对小段的音频做这个处理。大段的长音频，比如超过10分钟的音频，建议不要打开。注意，缓存模式下，由于浏览器并没有实时抛出音频当前播放中的时间，因此，如果选择打开默认的播放控件，播放控件中的时间进度是不会自动更新的。如果需要使用播放控件，可以自己再额外新建一个同步的时间轴，将时间通过音频的“更新播放器显示时间”动作，来更新播放控件的时间进度显示。",en:"Defines whether to keep the cache of the loaded audio in the browser in order to speed up when re-opening the same audio. Cached audios will not be interrupted when played with videos simultaneously.\nNote: this property is not suggested for large audio files."},showDes:1,order:5364,groupName:"default",linkZH:"",linkEN:""},{name:"controls",locale:{en:"showControl",zh:"显示播放条"},type:"Boolean",desc:{zh:"是否启用控制条。通过开关控制。通过控制条，用户能够对音频的暂停、播放及播放进度进行自主控制，可显示封面图片。默认不启用默控件，此时必须借助于事件控制视频播放。",en:"Defines whether to show the audio control bar."},order:5365,groupName:"default",showDes:1,linkZH:"",linkEN:""},{name:"poster",locale:{en:"coverURL",zh:"封面图片"},type:"Upload",desc:{zh:"当使用默认播放插件时，可为音频定义封面图片。可通过本地上传或直接调用已经上传的图片。",en:"Sets the URL of the cover image (only applicable when Show Controls property is enabled)."},order:5366,groupName:"default",showDes:1,linkZH:"",linkEN:""},{name:"name",locale:{en:"name",zh:"音频名"},type:"String",desc:{zh:"使用默认控件时显示的音频信息，默认为该音频对象名。可重新定义。",en:"Sets the name of the audio to display in the control bar (only applicable when Show Controls property is enabled)."},order:8991,groupName:"default",showDes:1,linkZH:"",linkEN:""},{name:"author",locale:{en:"author",zh:"作者名"},type:"String",desc:{zh:"使用默认控件时显示的音频信息，默认为“未知作者”。可重新定义。",en:"Sets the author of the audio to display in the control bar (only applicable when Show Controls property is enabled)"},order:9657,groupName:"default",showDes:1,linkZH:"",linkEN:""}],methods:[{name:"setPlay",locale:{en:"play",zh:"播放"},desc:{zh:"使音频开始播放。",en:"Plays the audio."},order:5367,groupName:"default",linkZH:"",linkEN:""},{name:"setPause",locale:{en:"pause",zh:"暂停"},desc:{zh:"使音频暂停播放。",en:"Pauses the audio."},order:5368,groupName:"default",linkZH:"",linkEN:""},{name:"togglePlay",locale:{en:"play/pause",zh:"播放/暂停"},desc:{zh:"切换音频的播放状态，如果当前为播放状态则暂停，如果为暂停状态则播放。",en:"Switches the status of play and pause."},order:5369,groupName:"default",linkZH:"",linkEN:""},{name:"jumpTo",locale:{en:"jumpTo",zh:"跳至"},params:[{name:"time",locale:{en:"timePosition(s)",zh:"跳至"},type:"Formula",desc:{zh:"目标位置的秒数。",en:"The time in second."}}],desc:{zh:"控制当前音频的播放进度，通过目标位置所处的秒数定义。",en:"Jumps to a specific time position of the audio. The play/pause status of the audio is not affected."},order:5370,groupName:"default",linkZH:"",linkEN:""},{name:"replay",locale:{en:"replay",zh:"重播"},desc:{zh:"从头开始重新播放音频。",en:"Replays the audio."},order:5371,groupName:"default",linkZH:"",linkEN:""},{name:"_audioCurrentTime",locale:{zh:"当前时间",en:"timePosition"},desc:{zh:"_audioCurrentTime",en:"The time position that the audio currently plays to. Unit in second."},groupName:"default",linkZH:"",linkEN:""},{name:"_audioTotalTime",locale:{zh:"总时长",en:"originalDuration"},desc:{zh:"_audioTotalTime",en:"The original duration of video. Unit in second."},groupName:"default",linkZH:"",linkEN:""},{name:"doUpdateTime",locale:{zh:"更新播放器显示时间",en:"doUpdateTime"},desc:{zh:"当音频开启缓存模式时，使用的是浏览器audio context接口，这个接口不支持实时反馈音频的播放进度。因此如果需要在缓存模式下，让自带的音频播放器\n控件中的时间进度更新，需要额外添加一个时间轴或触发器，将时间实时写入。（由于缓存模式，通常是针对音效类的短音频，因此ivx没有将此自动更新时间的方法封装至音频组件，以免在不必要