<view class="container">
  <view class="payment-card">
    <view class="header">
      <view class="shop-name">沈仙子 AI</view>
      <view class="title">确认支付</view>
    </view>

    <view class="amount-section">
      <text class="currency">￥</text>
      <text class="amount">{{amount}}</text>
    </view>

    <view class="info-list">
      <view class="info-item">
        <text class="label">产品名称</text>
        <text class="value">{{productName}}</text>
      </view>
      <view class="info-item">
        <text class="label">到期时间</text>
        <text class="value highlight">{{expiryDate}}</text>
      </view>
      <view class="info-item">
        <text class="label">支付状态</text>
        <text class="value status {{loading ? 'loading' : ''}}">{{status}}</text>
      </view>
    </view>

    <view class="footer">
      <view wx:if="{{loading}}" class="loading-spinner"></view>
      <button wx:if="{{!loading}}" class="btn-action" bindtap="goBack">返回首页</button>
      <button wx:if="{{status === '支付已取消'}}" class="btn-action primary" bindtap="initiatePayment">重新支付</button>
    </view>
  </view>

  <view class="safety-tips">
    <icon type="success" size="14" color="#999"/>
    <text>微信支付安全环境已开启</text>
  </view>
</view>
