page {
  background-color: #f9fafb;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  box-sizing: border-box;
}

.result-section {
  margin-bottom: 32rpx;
}

.status-label {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.input-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.result-input {
  flex: 1;
  min-height: 160rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background-color: #ffffff;
  color: #111827;
}

.result-input[disabled] {
  color: #111827;
}

.timer {
  width: 120rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  background-color: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #111827;
}

.log-section {
  flex: 1;
  min-height: 200rpx;
  margin-bottom: 32rpx;
}

.log-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 16rpx;
}

.log-list {
  max-height: 520rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  background-color: #ffffff;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.log-item {
  margin-bottom: 12rpx;
}

.log-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 8rpx;
}

.log-message {
  font-size: 26rpx;
  color: #111827;
}

.footer {
  padding-top: 8rpx;
  padding-bottom: 16rpx;
}

.record-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background-color: #3b82f6;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.record-btn.recording {
  background-color: #ef4444;
}

