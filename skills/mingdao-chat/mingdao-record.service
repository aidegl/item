[Unit]
Description=明道云消息记录服务
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/openclaw/workspace/skills/mingdao-chat
ExecStart=/usr/bin/node auto-record-daemon.js
Restart=always
RestartSec=5
StandardOutput=append:/home/admin/openclaw/workspace/skills/mingdao-chat/daemon.log
StandardError=append:/home/admin/openclaw/workspace/skills/mingdao-chat/daemon.log

# 资源限制
LimitNOFILE=65535
Nice=10

# 环境
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
